---
---

<section class="relative bg-slate-900 text-white py-20 lg:py-32 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-blue-500 via-slate-900 to-slate-900"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left side: Value Prop -->
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6">
          Crystal Clear Windows. <br/>
          <span class="text-blue-400">Zero Streaks. Zero Hassle.</span>
        </h1>
        <p class="text-lg md:text-xl text-slate-300 mb-8 leading-relaxed">
          Winnipeg's premier window cleaning service using advanced water-fed pole technology. We bring the shine back to your home, safely and efficiently.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4">
          <div class="flex items-center gap-2 text-sm font-semibold text-slate-300 bg-slate-800/50 px-4 py-2 rounded-full w-fit border border-slate-700">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Fully Insured
          </div>
          <div class="flex items-center gap-2 text-sm font-semibold text-slate-300 bg-slate-800/50 px-4 py-2 rounded-full w-fit border border-slate-700">
            <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            Eco-Friendly System
          </div>
        </div>
      </div>

      <!-- Right side: Pink's Windows Inspired Form Card -->
      <div class="bg-white rounded-2xl shadow-2xl p-6 sm:p-8 text-slate-900 lg:ml-auto w-full max-w-md border-t-8 border-blue-500 relative transform hover:-translate-y-1 transition-transform duration-300">
        <div class="absolute -top-4 -right-4 bg-yellow-400 text-yellow-900 font-bold px-4 py-1 rounded-full text-sm shadow-lg transform rotate-3">
          Fast Quotes!
        </div>
        
        <h2 class="text-2xl font-bold mb-2">Get Your Instant Quote</h2>
        <p class="text-slate-500 text-sm mb-6">Fill out the details below and we'll get back to you within 24 hours.</p>
        
        <form class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1" for="address">Property Address</label>
            <input type="text" id="address" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="123 Main St, Winnipeg">
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1" for="name">First Name</label>
              <input type="text" id="name" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="John">
            </div>
            <div>
              <label class="block text-sm font-medium text-slate-700 mb-1" for="phone">Phone</label>
              <input type="tel" id="phone" class="w-full px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" placeholder="(204) 555-0123">
            </div>
          </div>
          
          <button type="button" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-lg py-4 rounded-xl shadow-lg hover:shadow-blue-500/30 transition-all active:scale-[0.98]">
            Get My Quote →
          </button>
        </form>
        
        <p class="text-center text-xs text-slate-400 mt-4">
          No commitment required. Your data is secure.
        </p>
      </div>

    </div>
  </div>
</section>
